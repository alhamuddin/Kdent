generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  ISSUED
  CANCELLED
  AMENDED
}

enum DiagnosisType {
  PROVISIONAL
  CONFIRMED
  DIFFERENTIAL
}

enum MedicationRoute {
  ORAL
  TOPICAL
  INTRAVENOUS
  INTRAMUSCULAR
  SUBCUTANEOUS
  INHALATION
  NASAL
  OPHTHALMIC
  OTIC
  RECTAL
  VAGINAL
  SUBLINGUAL
  TRANSDERMAL
  OTHER
}

enum DoseTiming {
  BEFORE_FOOD
  AFTER_FOOD
  WITH_FOOD
  EMPTY_STOMACH
  ANY_TIME
  OTHER
}

enum InvestigationType {
  LABORATORY
  IMAGING
  PROCEDURE
  OTHER
}

enum InvestigationPriority {
  ROUTINE
  URGENT
  STAT
}

enum InvestigationStatus {
  ORDERED
  COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

model Patient {
  id                    String   @id @default(cuid())
  patientNumber         String   @unique
  firstName             String
  lastName              String?
  dateOfBirth           DateTime? @db.Date
  sex                   Sex      @default(UNKNOWN)
  phone                 String?
  email                 String?
  address               String?
  bloodGroup            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  guardianName          String?
  guardianPhone         String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  prescriptions Prescription[]
  allergies     PatientAllergy[]
  appointments  Appointment[]
}

model Doctor {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String?
  qualifications   String?
  specialty        String?
  designation      String?
  bmdcRegistration String?  @unique
  phone            String?
  email            String?
  chamberName      String?
  chamberAddress   String?
  digitalSignature String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  prescriptions Prescription[]
  appointments  Appointment[]
}

model Appointment {
  id             String   @id @default(cuid())
  patientId      String
  doctorId       String
  scheduledAt    DateTime @db.Timestamptz(3)
  chiefComplaint String?
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  prescription Prescription?

  @@index([patientId, scheduledAt])
  @@index([doctorId, scheduledAt])
}

model Prescription {
  id             String @id @default(cuid())
  prescriptionNo String @unique

  patientId     String
  doctorId      String
  appointmentId String? @unique

  issuedAt DateTime           @default(now()) @db.Timestamptz(3)
  status   PrescriptionStatus @default(DRAFT)

  chiefComplaint          String?
  historyOfPresentIllness String?
  pastMedicalHistory      String?
  pastSurgicalHistory     String?
  familyHistory           String?
  socialHistory           String?
  currentMedicationNotes  String?
  clinicalNotes           String?

  examinationFindings String?
  generalAppearance   String?
  systemicExamination String?

  weightKg        Decimal? @db.Decimal(6, 2)
  heightCm        Decimal? @db.Decimal(6, 2)
  temperatureC    Decimal? @db.Decimal(4, 1)
  systolicBP      Int?
  diastolicBP     Int?
  pulseBpm        Int?
  respiratoryRate Int?
  oxygenSaturation Decimal? @db.Decimal(5, 2)
  bmi              Decimal? @db.Decimal(5, 2)
  vitalNotes       String?

  treatmentPlan       String?
  dietAdvice          String?
  lifestyleAdvice     String?
  precautions         String?
  patientInstructions String?
  referralNotes       String?

  followUpDate   DateTime? @db.Timestamptz(3)
  followUpNotes  String?
  reviewRequired Boolean   @default(false)

  signedAt           DateTime? @db.Timestamptz(3)
  signatureUrl       String?
  cancellationReason String?
  amendedFromId      String?
  version            Int       @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  patient        Patient                     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor         Doctor                      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment    Appointment?                @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  diagnoses      PrescriptionDiagnosis[]
  medications    PrescriptionMedication[]
  investigations PrescriptionInvestigation[]
  procedures     PrescriptionProcedure[]
  followUps      FollowUp[]
  referrals      Referral[]

  @@index([patientId, issuedAt])
  @@index([doctorId, issuedAt])
  @@index([status, issuedAt])
}

model Diagnosis {
  id          String  @id @default(cuid())
  code        String?
  codeSystem  String?
  name        String
  description String?

  prescriptionDiagnoses PrescriptionDiagnosis[]

  @@unique([codeSystem, code])
  @@index([name])
}

model PrescriptionDiagnosis {
  id             String       @id @default(cuid())
  prescriptionId String
  diagnosisId    String
  type           DiagnosisType @default(CONFIRMED)
  notes          String?
  isPrimary      Boolean      @default(false)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  diagnosis    Diagnosis    @relation(fields: [diagnosisId], references: [id], onDelete: Restrict)

  @@unique([prescriptionId, diagnosisId])
  @@index([diagnosisId])
}

model Medication {
  id           String  @id @default(cuid())
  genericName  String
  brandName    String?
  strength     String?
  dosageForm   String?
  manufacturer String?
  description  String?
  isActive     Boolean @default(true)

  prescriptionItems PrescriptionMedication[]

  @@index([genericName])
  @@index([brandName])
}

model PrescriptionMedication {
  id             String  @id @default(cuid())
  prescriptionId String
  medicationId   String?

  medicineName String
  genericName  String?
  strength     String?
  dosageForm   String?

  dose             String
  route            MedicationRoute @default(ORAL)
  frequency        String
  durationValue    Int?
  durationUnit     String?
  quantity         Decimal? @db.Decimal(10, 2)
  quantityUnit     String?
  timing           DoseTiming @default(ANY_TIME)
  instructions     String?
  prn              Boolean   @default(false)
  prnReason        String?
  maximumDailyDose String?
  refills          Int       @default(0)
  sortOrder        Int       @default(0)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication?  @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([prescriptionId, sortOrder])
  @@index([medicationId])
}

model Investigation {
  id          String            @id @default(cuid())
  code        String?           @unique
  name        String
  type        InvestigationType
  description String?
  isActive    Boolean           @default(true)

  prescriptionItems PrescriptionInvestigation[]

  @@index([name])
}

model PrescriptionInvestigation {
  id              String @id @default(cuid())
  prescriptionId  String
  investigationId String?

  investigationName String
  type              InvestigationType
  priority          InvestigationPriority @default(ROUTINE)
  status            InvestigationStatus   @default(ORDERED)
  clinicalReason    String?
  instructions      String?
  orderedAt         DateTime @default(now()) @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)

  resultSummary       String?
  resultNotes         String?
  resultAttachmentUrl String?

  prescription  Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  investigation Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)

  @@index([prescriptionId, status])
  @@index([investigationId])
}

model PatientAllergy {
  id         String         @id @default(cuid())
  patientId  String
  substance  String
  reaction   String?
  severity   AllergySeverity @default(UNKNOWN)
  notes      String?
  verifiedAt DateTime?      @db.Timestamptz(3)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, isActive])
}

model PrescriptionProcedure {
  id             String    @id @default(cuid())
  prescriptionId String
  name           String
  instructions   String?
  scheduledAt    DateTime? @db.Timestamptz(3)
  notes          String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model Referral {
  id             String @id @default(cuid())
  prescriptionId String
  specialty      String?
  referredTo     String?
  facilityName   String?
  reason         String
  urgency        InvestigationPriority @default(ROUTINE)
  notes          String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model FollowUp {
  id             String         @id @default(cuid())
  prescriptionId String
  scheduledAt    DateTime       @db.Timestamptz(3)
  status         FollowUpStatus @default(SCHEDULED)
  reason         String?
  notes          String?
  completedAt    DateTime?      @db.Timestamptz(3)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, status])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
