generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum UserRole {
  USER
  DOCTOR
  ASSISTANT
  ADMIN
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum AppointmentSource {
  ONLINE
  OFFLINE
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  ISSUED
  CANCELLED
  AMENDED
}

enum DiagnosisType {
  PROVISIONAL
  CONFIRMED
  DIFFERENTIAL
}

enum MedicationRoute {
  ORAL
  TOPICAL
  INTRAVENOUS
  INTRAMUSCULAR
  SUBCUTANEOUS
  INHALATION
  NASAL
  OPHTHALMIC
  OTIC
  RECTAL
  VAGINAL
  SUBLINGUAL
  TRANSDERMAL
  OTHER
}

enum InvestigationType {
  LABORATORY
  IMAGING
  PROCEDURE
  OTHER
}

enum InvestigationPriority {
  ROUTINE
  URGENT
  STAT
}

enum InvestigationStatus {
  ORDERED
  COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

model Patient {
  id            String    @id @default(cuid())
  patientNumber String    @unique
  firstName     String
  lastName      String?
  dateOfBirth   DateTime? @db.Date
  sex           Sex       @default(OTHER)
  phone         String?
  email         String?
  heightCm      Decimal?  @db.Decimal(5, 2)
  weightKg      Decimal?  @db.Decimal(6, 2)
  userId        String?   @unique
  isRegistered  Boolean   @default(true)
  bloodGroup    String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  prescriptions Prescription[]
  allergies     PatientAllergy[]
  appointments  Appointment[]
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Doctor {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String?
  qualifications   String?
  specialty        String?
  designation      String?
  bmdcRegistration String?  @unique
  phone            String?
  email            String?
  chamberName      String?
  chamberAddress   String?
  digitalSignature String?
  userId           String?  @unique
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]
  appointments  Appointment[]
  schedules     DoctorSchedule[]
}

model Appointment {
  id                String            @id @default(cuid())
  patientId         String
  doctorId          String
  scheduledAt       DateTime          @db.Timestamptz(3)
  chiefComplaint    String?
  notes             String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  status            AppointmentStatus @default(ACCEPTED)
  source            AppointmentSource @default(OFFLINE)
  acceptedAt        DateTime?         @db.Timestamptz(3)
  serialNumber      Int?
  requestedByUserId String?
  clinicName        String?
  clinicAddress     String?

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  prescription Prescription?

  @@index([patientId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([doctorId, status, createdAt])
}

model DoctorSchedule {
  id            String   @id @default(cuid())
  doctorId      String
  weekday       Int
  clinicName    String   @default("Main clinic")
  clinicAddress String?
  startTime     String
  endTime       String
  slotMinutes   Int      @default(20)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, weekday, enabled])
}

model Prescription {
  id             String @id @default(cuid())
  prescriptionNo String @unique

  patientId     String
  doctorId      String
  appointmentId String? @unique

  issuedAt DateTime           @default(now()) @db.Timestamptz(3)
  status   PrescriptionStatus @default(DRAFT)
  signedAt DateTime?          @db.Timestamptz(3)

  chiefComplaint      String?
  medicalHistory      String?
  examination         String?
  investigationNotes  String?
  treatmentPlan       String?
  clinicalNotes       String?
  patientInstructions String?
  weightKg            Decimal? @db.Decimal(6, 2)
  bmi                 Decimal? @db.Decimal(5, 2)
  systolicBP          Int?
  diastolicBP         Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  patient        Patient                     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor         Doctor                      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment    Appointment?                @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  diagnoses      PrescriptionDiagnosis[]
  medications    PrescriptionMedication[]
  investigations PrescriptionInvestigation[]

  @@index([patientId, issuedAt])
  @@index([doctorId, issuedAt])
  @@index([status, issuedAt])
}

model Diagnosis {
  id          String  @id @default(cuid())
  code        String?
  codeSystem  String?
  name        String
  description String?

  prescriptionDiagnoses PrescriptionDiagnosis[]

  @@unique([codeSystem, code])
  @@index([name])
}

model PrescriptionDiagnosis {
  id             String        @id @default(cuid())
  prescriptionId String
  diagnosisId    String
  type           DiagnosisType @default(CONFIRMED)
  notes          String?
  isPrimary      Boolean       @default(false)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  diagnosis    Diagnosis    @relation(fields: [diagnosisId], references: [id], onDelete: Restrict)

  @@unique([prescriptionId, diagnosisId])
  @@index([diagnosisId])
}

model PrescriptionMedication {
  id             String @id @default(cuid())
  prescriptionId String

  medicineName  String
  dose          String
  route         MedicationRoute @default(ORAL)
  frequency     String
  durationValue Int?
  durationUnit  String?
  instructions  String?
  sortOrder     Int             @default(0)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, sortOrder])
}

model PrescriptionInvestigation {
  id             String @id @default(cuid())
  prescriptionId String

  investigationName String
  type              InvestigationType
  priority          InvestigationPriority @default(ROUTINE)
  status            InvestigationStatus   @default(ORDERED)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, status])
}

model PatientAllergy {
  id         String          @id @default(cuid())
  patientId  String
  substance  String
  reaction   String?
  severity   AllergySeverity @default(UNKNOWN)
  notes      String?
  verifiedAt DateTime?       @db.Timestamptz(3)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, isActive])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  doctor        Doctor?
  patient       Patient?

  @@unique([email])
  @@map("user")
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  message   String    @db.Text
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([readAt, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
